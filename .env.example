# Local Postgres (Postgres.app). Connects as your Mac user, no password needed.
DATABASE_URL=postgres://localhost:5432/agentdesk_dev
TEST_DATABASE_URL=postgres://localhost:5432/agentdesk_test

# The store's fixed "today". Seed dates and policy windows are relative to this.
STORE_DATE=2026-09-15

# Ollama server for local models (runs on the Mac mini on the home network).
# Use the Mac mini's LAN address, e.g. http://192.168.1.50:11434. No trailing /v1.
OLLAMA_BASE_URL=http://localhost:11434

# Which model config (server/config/models.json) to use. Empty = the file's default.
MODEL=

# Cloud API keys (free tiers). Never commit real keys.
GEMINI_API_KEY=
GROQ_API_KEY=
# Configured for later use (2026-10-06), not used yet. Paid, prepaid balance; agree a cap before using it.
DEEPSEEK_API_KEY=

# Record/replay cache for model calls: off | record | replay | refresh
# (replay = cache hits only, guaranteed $0; refresh = always call the model and re-record, for repeat eval runs).
LLM_CACHE=record

# Local ports. API_PORT: the API server (npm run serve). WEB_PORT: the Vite dev server
# (npm run dev -w web), which proxies /api to API_PORT. Vite won't silently move to
# another port if WEB_PORT is taken; it stops with an error instead.
API_PORT=8787
WEB_PORT=5180
# Dashboard actions (approve/reject, switch/retire) need this token; empty = actions disabled.
# At least 24 characters, e.g. the output of: openssl rand -hex 24
ADMIN_TOKEN=
