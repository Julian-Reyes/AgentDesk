{
  "name": "@switchyard/server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../.env src/scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=../.env src/seed/index.ts",
    "tool": "node --env-file-if-exists=../.env src/scripts/try-tool.ts",
    "smoke": "node --env-file-if-exists=../.env src/scripts/smoke-models.ts",
    "chat": "node --env-file-if-exists=../.env src/scripts/chat.ts",
    "serve": "node --env-file-if-exists=../.env src/scripts/serve.ts",
    "trace": "node --env-file-if-exists=../.env src/scripts/trace.ts",
    "eval:cases": "node --env-file-if-exists=../.env src/scripts/eval-cases.ts",
    "judge:sample": "node --env-file-if-exists=../.env src/scripts/judge-sample.ts",
    "judge:grade": "node --env-file-if-exists=../.env src/scripts/judge-grade.ts",
    "judge:agreement": "node --env-file-if-exists=../.env src/scripts/judge-agreement.ts",
    "eval:run": "node --env-file-if-exists=../.env src/scripts/eval-run.ts",
    "eval:judge": "node --env-file-if-exists=../.env src/scripts/eval-judge.ts",
    "eval:report": "node --env-file-if-exists=../.env src/scripts/eval-report.ts",
    "eval:compare": "node --env-file-if-exists=../.env src/scripts/eval-compare.ts",
    "eval:update-cases": "node --env-file-if-exists=../.env src/scripts/eval-update-cases.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
