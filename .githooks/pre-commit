#!/bin/sh
# Blocks the commit if the typecheck or the tests fail (Julian, 2026-10-02:
# a commit went in after a failed typecheck). Enable once per clone with:
#   git config core.hooksPath .githooks
# It checks the working tree, so unstaged edits count too. Tests need the
# local Postgres test database running.
cd "$(git rev-parse --show-toplevel)" || exit 1

echo "pre-commit: typecheck..."
if ! npm run -s typecheck; then
  echo "pre-commit: typecheck failed; commit blocked."
  exit 1
fi

echo "pre-commit: tests..."
log="$(mktemp)"
if ! npm test --silent >"$log" 2>&1; then
  tail -40 "$log"
  rm -f "$log"
  echo "pre-commit: tests failed; commit blocked."
  exit 1
fi
grep -E "Tests +[0-9]+ passed" "$log"
rm -f "$log"
